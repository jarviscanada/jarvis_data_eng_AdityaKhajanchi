      "text": "%sh\n\ncd ~\nhdfs  dfs -get  hdfs:///user/adityakhajanchi07/hive/wdi/wdi_csv_text\ncd wdi_csv_text\n\ndu -ch\n\necho 3 | sudo tee /proc/sys/vm/drop_caches\n\ndate +%s && cat * | wc && date +%s\n",
