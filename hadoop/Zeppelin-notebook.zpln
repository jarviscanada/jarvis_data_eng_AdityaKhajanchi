    {
      "text": "%md\r\nBecause `wdi_opencsv_text` uses standard `DELIMITED` formatting (not `OpenCSVSerde`), it writes data as raw text without quotes or escaping.\r\n\r\nHence, the resulting table again contains incorrectly parsed values in the `indicatorCode` column.\r\n",
      "user": "anonymous",
      "dateUpdated": "2025-07-23T21:44:40+0000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
          "language": "markdown",
          "editOnDblClick": true,
          "completionSupport": false
        },
        "colWidth": 12,
        "editorMode": "ace/mode/markdown",
        "fontSize": 9,
        "editorHide": true,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "HTML",
            "data": "<div class=\"markdown-body\">\n<p>Because <code>wdi_opencsv_text</code> uses standard <code>DELIMITED</code> formatting (not <code>OpenCSVSerde</code>), it writes data as raw text without quotes or escaping.</p>\n<p>Hence, the resulting table again contains incorrectly parsed values in the <code>indicatorCode</code> column.</p>\n\n</div>"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
