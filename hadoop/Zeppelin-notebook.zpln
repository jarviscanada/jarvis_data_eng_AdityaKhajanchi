    {
      "text": "-- Create a Table with OpenCSV SerDe\n\nDROP TABLE IF EXISTS wdi_opencsv_gs;\n\nCREATE EXTERNAL TABLE wdi_opencsv_gs (\n  year INT,\n  countryName STRING,\n  countryCode STRING,\n  indicatorName STRING,\n  indicatorCode STRING,\n  indicatorValue FLOAT\n)\nROW FORMAT SERDE 'org.apache.hadoop.hive.serde2.OpenCSVSerde'\nWITH SERDEPROPERTIES (\n  \"separatorChar\" = \",\",\n  \"quoteChar\" = \"\\\"\"\n)\nSTORED AS TEXTFILE\nLOCATION 'gs://jarvis_data_eng_aditya/datasets/wdi_2016'\nTBLPROPERTIES (\n  \"skip.header.line.count\" = \"1\"\n)",
      "user": "anonymous",
      "dateUpdated": "2025-07-23T21:06:07+0000",
      "progress": 0,
      "config": {
